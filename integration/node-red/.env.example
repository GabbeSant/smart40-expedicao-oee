# Copie para .env nesta pasta. Nenhuma configuração é embutida no frontend.
UNIT_ID=UNIDADE-SP
ASSET_ID=N2-EXPEDICAO
# Use simulado exclusivamente com dados de demonstração; medido para a bancada.
DATA_ORIGIN=medido
PRODUCTION_MODE=pieces
MQTT_LOCAL_HOST=127.0.0.1
MQTT_LOCAL_PORT=1883
NODE_RED_PORT=1880
NODE_RED_HOST=127.0.0.1
NODE_RED_EDITOR=true
STALE_AFTER_MS=15000
# Opcional: ISO UTC do início da sessão usada nos tempos para OEE.
# SESSION_STARTED_AT=2026-11-04T15:00:00Z

# Broker privado fornecido pela equipe. O conector exige TLS, porta padrão 8883.
MQTT_CLOUD_ENABLED=false
MQTT_CLOUD_HOST=
MQTT_CLOUD_PORT=8883
MQTT_CLOUD_USERNAME=
MQTT_CLOUD_PASSWORD=
# Gere um segredo local para a criptografia de credenciais do editor.
NODE_RED_CREDENTIAL_SECRET=
# Editor fora de localhost: hash bcrypt obrigatório.
NODE_RED_ADMIN_USER=admin
NODE_RED_ADMIN_HASH=
# Consulta REST opcional (somente leitura).
PRODUCTION_ORDERS_BASE_URL=http://192.168.150.200:5678

# Caminho A: o broker dos PDFs é WebSocket, não um broker MQTT.
# URL da instância confirmada da turma; não use a URL ilustrativa como destino real.
# Esta conexão é de saída do gateway; o módulo Grupo 5 no navegador continua sem socket próprio.
BROKER_URL=
TOKEN_AGENTE=
