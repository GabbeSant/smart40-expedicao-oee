# PostgreSQL próprio. Na nuvem, TLS verifica certificado e hostname.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/smart40
PG_SSL_MODE=disable
# Para nuvem: PG_SSL_MODE=verify-full; PG_CA_FILE opcional se o provedor usar CA própria.
MES_HOST=127.0.0.1
PORT=4321
# Substitua os exemplos por segredos únicos, mantendo-os fora do frontend/repositório.
# O token read do Shell fica limitado à unidade correspondente.
MES_TOKENS_JSON=[{"token":"substitua-por-segredo-de-escrita","unitId":"UNIDADE-SP","role":"write"},{"token":"substitua-por-segredo-de-leitura","unitId":"UNIDADE-SP","role":"read"}]
MES_ALLOWED_ORIGINS=http://localhost:8080
